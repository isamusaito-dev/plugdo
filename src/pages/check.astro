---
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://plugdo.jp';

// レポート贈呈バナー。public/ に置かれていれば表示する。
// 未配置でも壊れないよう、ビルド時に実在を確認してから描画する。
// 差し替えるときは同じ名前で上書きすれば、この分岐はそのまま使える。
const bannerCandidates = ['/report-banner.webp', '/report-banner.jpg', '/report-banner.png'];
const reportBanner =
  bannerCandidates.find((p) =>
    fs.existsSync(new URL(`../../public${p}`, import.meta.url))
  ) ?? null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: '無料Web診断', item: `${SITE_URL}/check/` },
  ],
};

// 副CTA「結果をメールで受け取る」の送信先（既存 contact と同じ Formspree を流用）。
const FORMSPREE_ENDPOINT =
  import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || 'https://formspree.io/f/mwvjwbll';

// 診断中に順番に点灯するチェック項目（7軸。専門用語は使わない）。
const checkSteps = [
  '第一印象をチェック中…',
  '何の会社か伝わるか確認中…',
  '問い合わせのしやすさを確認中…',
  'スマホ表示をチェック中…',
  '検索・AIに見つけてもらえるか確認中…',
  '実績・お客様の声を確認中…',
  'ページの表示速度をチェック中…',
];
---

<BaseLayout
  title="無料Web診断｜URLを入れるだけ、30秒で採点"
  description="ホームページのURLを入れるだけ。プロのWebデザイナーが設計した診断ロジックが、30秒で「問い合わせにつながる状態か」を7つの視点で採点します。中小企業の経営者向け、無料。"
  ogImage="/og-check.png"
  jsonLd={breadcrumbLd}
>
  <!-- ══ 画面① 入口（URL入力） ══ -->
  <section id="screen-input" class="hero-gradient">
    <div class="container-pd py-16 md:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <p class="section-label justify-center">- Web Check -</p>
        <h1 class="section-title mt-2">
          そのホームページ、<br class="md:hidden" />問い合わせに<br />つながっていますか？
        </h1>
        <p class="mt-6 text-base leading-relaxed text-ink md:text-lg">
          URLを入れるだけ。30秒で、プロの視点であなたのサイトを採点します。
        </p>

        <form id="check-form" class="mx-auto mt-8 max-w-xl">
          <div class="flex flex-col gap-3 sm:flex-row">
            <input
              id="url-input"
              type="text"
              inputmode="url"
              autocomplete="url"
              required
              placeholder="例：plugdo.jp"
              class="w-full flex-1 rounded-full border border-mist px-6 py-4 text-base shadow-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/20"
            />
            <button type="submit" class="btn-pink shrink-0 whitespace-nowrap !px-8 !py-4">
              無料で診断する
            </button>
          </div>
          <p id="input-error" class="mt-3 hidden text-sm font-bold text-pink" role="alert"></p>
        </form>

        <p class="mt-6 text-xs text-gray">
          ＊ プロのWebデザイナーが設計した診断ロジック。入力されたURLは診断のみに利用します。
        </p>

        <!-- 診断すると何がもらえるのかを入口で先に見せ、URL入力の動機を上げる -->
        {
          reportBanner && (
            <div class="mt-12 rounded-2xl border border-pink/25 bg-paper p-6 md:p-8">
              <p class="inline-flex items-center gap-1.5 rounded-full bg-pink px-3.5 py-1 text-xs font-bold text-paper">
                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2.5" y="8" width="15" height="9.5" rx="1.5" /><path d="M1.5 8h17M10 8v9.5" />
                  <path d="M10 8S8.2 3.5 6.2 3.5a2 2 0 0 0 0 4.5M10 8s1.8-4.5 3.8-4.5a2 2 0 0 1 0 4.5" />
                </svg>
                診断された方へ
              </p>
              <h2 class="mt-3 text-xl font-black leading-snug text-navy md:text-2xl">
                無料の「診断改善レポート」を<span class="text-navy">プレゼント</span>
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-ink">
                スコアだけでなく、<strong class="font-bold text-navy">どこから・どう直すか</strong>まで。
                あなたのサイト専用のレポートを、ご希望の方にお送りします。
              </p>

              <img
                src={reportBanner}
                alt="無料の診断改善レポートを贈呈。改善ポイントと優先順位がわかる、あなたのサイト専用のレポートをお届けします。"
                class="mx-auto mt-6 block h-auto w-full max-w-xl rounded-xl"
                loading="lazy"
                decoding="async"
              />

              <ul class="mx-auto mt-6 max-w-md space-y-2 text-left">
                {
                  [
                    '見つかった指摘の内容（全件）',
                    'それぞれ、どう直すかの具体的な手順',
                    'どこから手をつけるべきかの優先順位',
                  ].map((item) => (
                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink">
                      <svg class="mt-1 shrink-0" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="#1F9D6B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7.5l3 3 6-7" /></svg>
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>

              <p class="mt-6 text-xs leading-relaxed text-gray">
                まずは上のフォームから診断してください。結果画面からお申し込みいただけます。
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ══ 画面② 診断中 ══ -->
  <section id="screen-loading" class="hidden">
    <div class="container-pd py-20 md:py-28">
      <div class="mx-auto max-w-md text-center">
        <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-pink">
          Analyzing
        </p>
        <p id="loading-url" class="mt-2 break-all text-sm text-gray"></p>
        <h2 class="mt-3 text-2xl font-black text-navy">プロの視点で診断しています</h2>

        <!-- 進捗カウンター -->
        <div class="mt-6 flex items-baseline justify-center gap-1">
          <span id="loading-percent" class="font-display text-5xl font-black text-navy [font-variant-numeric:tabular-nums]">0</span>
          <span class="font-display text-lg font-bold text-gray">%</span>
        </div>
        <div class="mx-auto mt-3 h-1 w-56 overflow-hidden rounded-full bg-mist">
          <div id="loading-bar" class="h-full w-0 rounded-full bg-pink transition-[width] duration-300 ease-out"></div>
        </div>

        <ul class="mx-auto mt-10 max-w-sm space-y-4 text-left">
          {
            checkSteps.map((step, i) => (
              <li
                class="check-step flex items-center gap-3 text-sm text-gray opacity-40 transition-all duration-500"
                data-step={i}
              >
                <span class="check-dot flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-mist">
                  <span class="check-spinner hidden h-3 w-3 animate-spin rounded-full border-2 border-pink border-t-transparent" />
                  <svg class="check-done hidden h-4 w-4 text-paper" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
                <span class="check-label font-bold">{step}</span>
              </li>
            ))
          }
        </ul>

        <!-- チェック完了後〜結果表示までの待ち時間を埋める -->
        <div id="analyze-finalizing" class="mt-9 hidden items-center justify-center gap-2.5 text-sm font-bold text-navy">
          <span class="h-4 w-4 animate-spin rounded-full border-2 border-pink border-t-transparent"></span>
          <span>結果をまとめています…</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 画面③ 結果 ══ -->
  <!-- ══ 画面③-B JavaScriptで描画するサイト（SPA）だった場合 ══
       中身がHTMLに無いサイトを通常採点すると、実在する要素まで「無い」と判定され
       事実と違うスコアが出る。採点は出さず、HTMLが空であること自体を課題として伝える。 -->
  <section id="screen-spa" class="hidden">
    <div class="container-pd py-16 md:py-20">
      <div class="mx-auto max-w-3xl">
        <p class="text-center text-sm text-gray">
          診断結果：<span id="spa-url" class="break-all font-bold text-navy"></span>
        </p>

        <div class="mt-6 rounded-2xl border border-navy/10 bg-navy/[0.03] px-6 py-8 text-center md:px-10">
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-navy text-paper" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12s-3.5 6.5-9.5 6.5S2.5 12 2.5 12z" />
              <circle cx="12" cy="12" r="2.6" /><path d="M3.5 3.5l17 17" />
            </svg>
          </span>
          <h2 class="mt-4 text-xl font-black leading-snug text-navy md:text-2xl">
            このサイトは、検索エンジンやAIから<br class="hidden sm:block" />
            <span class="text-pink">中身が見えない状態</span>です
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-ink">
            <span id="spa-framework" class="font-bold text-navy"></span>で作られており、
            ページの中身がすべてJavaScriptで表示される作りになっています。
            そのため、最初に配信されるHTMLには本文が
            <span id="spa-length" class="font-bold text-pink"></span>しか入っていません。
          </p>
          <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-ink">
            画面上は正しく表示されているため、人の目には問題なく見えます。
            採点は、実態と食い違う結果になるため今回は行いません。
          </p>
        </div>

        <!-- 誰にどう見えるか -->
        <div class="mt-10">
          <h3 class="text-lg font-black text-navy">相手によって、見え方が変わります</h3>
          <div class="mt-4 grid gap-3 md:grid-cols-3">
            <div class="rounded-xl border border-mist bg-paper p-5">
              <p class="text-sm font-black text-navy">サイトを見に来た人</p>
              <p class="mt-2 inline-block rounded-full bg-good/10 px-2.5 py-0.5 text-xs font-bold" style="color:#1F9D6B">問題なし</p>
              <p class="mt-3 text-xs leading-relaxed text-gray">
                ブラウザがJavaScriptを実行するので、いつもどおり表示されます。
              </p>
            </div>
            <div class="rounded-xl border border-mist bg-paper p-5">
              <p class="text-sm font-black text-navy">Google検索</p>
              <p class="mt-2 inline-block rounded-full bg-gold/15 px-2.5 py-0.5 text-xs font-bold text-gold">遅れる</p>
              <p class="mt-3 text-xs leading-relaxed text-gray">
                JavaScriptを実行しますが、後回しの順番待ちに入るため、
                内容の反映が遅れます。
              </p>
            </div>
            <div class="rounded-xl border border-pink/30 bg-pink/5 p-5">
              <p class="text-sm font-black text-navy">AI検索</p>
              <p class="mt-2 inline-block rounded-full bg-pink/15 px-2.5 py-0.5 text-xs font-bold text-pink">見えない</p>
              <p class="mt-3 text-xs leading-relaxed text-ink">
                ChatGPTなどのクローラーはJavaScriptを実行しません。
                <strong class="font-bold text-navy">中身の無いページとして扱われ</strong>、
                回答に引用されません。
              </p>
            </div>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-gray">
            ＊ AI経由で会社を調べる人が増えているため、今後この差は広がります。
          </p>
        </div>

        <!-- CV -->
        <div class="mt-10">
          <div class="rounded-xl border border-pink/30 bg-pink/5 p-7 shadow-[0_2px_16px_rgba(16,51,102,0.06)] md:p-9">
            <p class="text-center text-lg font-black leading-relaxed text-navy">
              作り直さずに、直せる場合があります。
            </p>
            <p class="mx-auto mt-3 max-w-md text-center text-sm leading-relaxed text-ink">
              今の見た目のまま、HTMLに中身が入る形へ変える方法があります。
              どの方法が使えるかはサイトの作りによって変わるため、
              個別に確認してご案内します。
            </p>
            <div class="mt-7 text-center">
              <a id="spa-cta" href="/contact/" class="btn-pink w-full sm:w-auto">
                無料で個別に相談する（オンライン30分）
              </a>
              <p class="mt-4 text-xs leading-relaxed text-gray">
                無料・契約不要／しつこい営業電話はいたしません。
              </p>
            </div>
          </div>

          <div class="mt-6 text-center">
            <button id="spa-retry" class="text-sm font-bold text-navy underline underline-offset-4 hover:text-pink">
              別のサイトを診断する
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 画面③ 結果 ══ -->
  <section id="screen-result" class="hidden">
    <div class="container-pd py-16 md:py-20">
      <div class="mx-auto max-w-3xl">
        <!-- 結果を見る前に「レポートがもらえる」ことを先に伝え、下のCVまで意識を持たせる -->
        <div class="reveal mb-8 overflow-hidden rounded-2xl border border-navy/10 bg-navy/[0.03]" data-reveal="0">
          <a href="#report-form" class="flex items-center gap-3 px-5 py-4 no-underline md:justify-center md:gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-navy text-paper" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="8" width="15" height="9.5" rx="1.5" /><path d="M1.5 8h17M10 8v9.5" />
                <path d="M10 8S8.2 3.5 6.2 3.5a2 2 0 0 0 0 4.5M10 8s1.8-4.5 3.8-4.5a2 2 0 0 1 0 4.5" />
              </svg>
            </span>
            <span class="flex-1 md:flex-none">
              <span class="block text-sm font-black leading-snug text-navy md:text-base">
                無料の「診断改善レポート」をプレゼント
              </span>
              <span class="mt-0.5 block text-xs leading-snug text-gray">
                この結果をもとに、どこからどう直すかをまとめてお送りします
              </span>
            </span>
            <span class="shrink-0 text-navy" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8h12M9 3l5 5-5 5" /></svg>
            </span>
          </a>
        </div>

        <p class="reveal text-center text-sm text-gray" data-reveal="0">
          診断結果：<span id="result-url" class="break-all font-bold text-navy"></span>
        </p>

        <!-- 総合スコア ゲージ -->
        <div class="reveal mt-6 text-center" data-reveal="1">
          <div class="relative mx-auto h-48 w-48">
            <svg class="h-full w-full -rotate-90" viewBox="0 0 120 120">
              <circle cx="60" cy="60" r="52" fill="none" stroke="#EBEEF2" stroke-width="12" />
              <circle
                id="gauge-arc"
                cx="60"
                cy="60"
                r="52"
                fill="none"
                stroke="#E43172"
                stroke-width="12"
                stroke-linecap="round"
                stroke-dasharray="326.7"
                stroke-dashoffset="326.7"
                style="transition: stroke-dashoffset 1.4s cubic-bezier(0.22,1,0.36,1);"
              />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span id="gauge-number" class="font-display text-5xl font-black text-navy">0</span>
              <span class="text-xs font-bold tracking-wider text-gray">/ 100点</span>
            </div>
          </div>
          <p id="band-message" class="mx-auto mt-5 max-w-md text-base font-bold leading-relaxed text-navy"></p>
        </div>

        <!-- 7軸スコア（チェック項目は全公開。直し方のみ詳細レポートでゲート） -->
        <div class="reveal mt-12" data-reveal="2">
          <h3 class="text-lg font-black text-navy">7つの視点で見ると</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-gray">
            各項目は、あなたのサイトを実際にチェックした結果です（<span class="font-bold" style="color:#1F9D6B">✓</span>＝できている／<span class="font-bold text-pink">✕</span>＝もったいない）。
          </p>
          <!-- CVまでのスクロールを短くするため2カラムに並べる（スマホは1カラム） -->
          <div id="axes" class="mt-5 grid gap-3 md:grid-cols-2"></div>

          <!-- ゲートの予告。ここを弱くすると下のフォームまで意識が続かない。
               見出しは flex にしないこと。インラインの span が独立した行になり、
               スマホで単語の途中で改行されて読みにくくなる。 -->
          <div class="mt-6 rounded-2xl border border-navy/10 bg-navy/[0.03] px-5 py-6 text-center">
            <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-navy text-paper" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3.5" width="16" height="13" rx="2"/><path d="M2.5 5.5l7.5 5 7.5-5"/></svg>
            </span>
            <p class="mt-3.5 text-base font-black leading-relaxed text-navy md:text-lg">
              各項目を「どう直すか」は、<br class="sm:hidden" /><span class="text-navy">無料レポート</span>でお送りします
            </p>
            <a href="#report-form" class="btn-pink mt-5 !px-7 !py-3 text-sm">
              無料レポートを受け取る
            </a>
          </div>
        </div>

        <!-- ゲート＋CTA（主：詳細レポートのメール送付＝リード取得／副：今すぐ無料相談）
             指摘の「中身」は画面に出さず、件数だけ示してレポートへ引く。
             全部見せると受け取る理由が無くなるため、ここが実質のCV導線。
             NOTE: レポートは自動送信ではなく、Formspree のリード通知を見て担当者が手動で作成・返信する運用。
                   そのため「1営業日以内」と明示している。将来的に自動生成・自動送信へ移行する場合は
                   この文言と運用フローをあわせて見直すこと。 -->
        <div id="report-form" class="reveal mt-12 scroll-mt-24" data-reveal="3">
          <!-- .card は使わない（ホバーで浮き上がる動きが付いてくるため）。CVはここだけ赤系にする。 -->
          <div class="rounded-xl border border-pink/30 bg-pink/5 p-7 shadow-[0_2px_16px_rgba(16,51,102,0.06)] md:p-9">
            <!-- 見つかった件数（中身は伏せる） -->
            <div class="text-center">
              <p class="text-sm font-bold text-navy">このサイトで見つかった「もったいない」ポイント</p>
              <p class="mt-3 flex items-baseline justify-center gap-1">
                <span id="issue-count" class="font-display text-6xl font-black leading-none text-pink [font-variant-numeric:tabular-nums]">0</span>
                <span class="text-xl font-black text-navy">件</span>
              </p>
            </div>

            <div class="mx-auto mt-7 max-w-md border-t border-pink/20 pt-6">
              <p id="gate-headline" class="text-center text-lg font-black leading-relaxed text-navy"></p>
              <p id="gate-desc" class="mt-3 text-center text-sm leading-relaxed text-ink"></p>
            </div>

            <!-- 何が届くのかを一目で伝えるバナー（public/report-banner.* を置くと表示される） -->
            {
              reportBanner && (
                <div class="mx-auto mt-6 max-w-lg overflow-hidden rounded-xl border border-pink/15 bg-paper">
                  <img
                    src={reportBanner}
                    alt="無料の診断改善レポートを贈呈。改善ポイントと優先順位がわかる、あなたのサイト専用のレポートをお届けします。"
                    class="block h-auto w-full"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )
            }

            <!-- レポートに含まれる内容 -->
            <ul class="mx-auto mt-6 max-w-md space-y-2.5 rounded-xl bg-paper/70 p-5">
              {
                [
                  '見つかった指摘の内容（全件）',
                  'それぞれ、どう直すかの具体的な手順',
                  'どこから手をつけるべきかの優先順位',
                ].map((item) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink">
                    <svg class="mt-1 shrink-0" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="#1F9D6B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7.5l3 3 6-7" /></svg>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>

            <!-- 入力欄は1列に統一。横並びだと項目が多く見え、離脱しやすくなるため。
                 送信後は見出しごと隠すため、フォーム単体ではなくこのブロックを切り替える。 -->
            <div id="report-form-body" class="mx-auto mt-7 max-w-md border-t border-pink/20 pt-6">
              <p class="text-center text-base font-black text-navy">レポートのお届け先</p>
              <p class="mt-1.5 text-center text-xs text-gray">3項目のみ・30秒で完了します</p>

              <form id="mail-form" action={FORMSPREE_ENDPOINT} method="POST" class="mt-5 space-y-2.5">
                <!-- ハニーポット（スパム対策） -->
                <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
                <input
                  id="name-input"
                  type="text"
                  name="お名前"
                  required
                  autocomplete="name"
                  placeholder="お名前"
                  class="w-full rounded-full border border-mist px-5 py-3 text-sm focus:border-navy focus:outline-none focus:ring-1 focus:ring-navy"
                />
                <input
                  id="company-input"
                  type="text"
                  name="会社名"
                  required
                  autocomplete="organization"
                  placeholder="会社名"
                  class="w-full rounded-full border border-mist px-5 py-3 text-sm focus:border-navy focus:outline-none focus:ring-1 focus:ring-navy"
                />
                <input
                  id="mail-input"
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="メールアドレス"
                  class="w-full rounded-full border border-mist px-5 py-3 text-sm focus:border-navy focus:outline-none focus:ring-1 focus:ring-navy"
                />
                <button type="submit" class="btn-pink !mt-4 w-full">
                  無料で詳細レポートを受け取る
                </button>
              </form>
            </div>
            <p id="mail-done" class="mx-auto mt-4 hidden max-w-md text-center text-sm font-bold leading-relaxed text-navy" role="status"></p>
            <p id="mail-error" class="mt-2 hidden text-center text-xs text-pink" role="alert"></p>
            <p id="mail-note" class="mt-4 text-center text-xs leading-relaxed text-gray">
              1営業日以内に、ご入力のメールアドレスへお送りします。<br class="hidden sm:block" />
              無料・契約不要／しつこい営業電話はいたしません。
            </p>
          </div>

          <!-- 副CTA：レポートを待たずに今すぐ相談したい人向け -->
          <div class="mt-6 rounded-xl border border-mist bg-paper p-6 text-center md:p-7">
            <p class="text-sm font-bold text-navy">レポートを待たずに、今すぐ相談したい方へ</p>
            <a id="cta-consult" href="/contact/" class="btn-navy mt-4 w-full sm:w-auto">
              無料相談（オンライン30分）を予約する
            </a>
            <div class="mt-4">
              <a id="cta-secondary" href="/renewal/" class="text-sm font-bold text-navy underline underline-offset-4 hover:text-pink"></a>
            </div>
          </div>

          <div class="mt-6 text-center">
            <button id="retry" class="text-sm font-bold text-navy underline underline-offset-4 hover:text-pink">
              別のサイトを診断する
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const $ = (id) => document.getElementById(id);
    const esc = (s) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const screens = {
      input: $('screen-input'),
      loading: $('screen-loading'),
      result: $('screen-result'),
      spa: $('screen-spa'),
    };
    const show = (name) => {
      Object.entries(screens).forEach(([k, el]) => el.classList.toggle('hidden', k !== name));
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const colorHex = { red: '#E43172', yellow: '#C8A951', green: '#1F9D6B' };

    // ── JavaScriptで描画するサイト（SPA）向けの表示 ──
    function renderSpa(data) {
      $('spa-url').textContent = data.url;
      $('spa-framework').textContent = data.framework || 'JavaScriptの仕組み';
      $('spa-length').textContent = (data.bodyTextLength || 0) + '文字';
      // 相談フォームに、通常診断と同じくURLを引き継ぐ
      $('spa-cta').href = '/contact/?' + new URLSearchParams({ url: data.url, type: 'spa' }).toString();
      document.querySelectorAll('#screen-spa .reveal').forEach((el) => el.classList.add('is-in'));
    }
    let lastResult = null; // 副CTA（メール受取）に引き継ぐ最新の診断結果

    // ── 診断中アニメ：チェック項目を順に点灯＋％カウンター ──
    let stepTimers = [];
    let percentTimer = null;
    function runLoadingAnimation() {
      const steps = Array.from(document.querySelectorAll('.check-step'));
      stepTimers.forEach(clearTimeout);
      stepTimers = [];
      if (percentTimer) clearInterval(percentTimer);
      // ％カウンター：約6.5秒かけて0→99（結果表示までの体感演出）
      const pctEl = $('loading-percent');
      const barEl = $('loading-bar');
      pctEl.textContent = '0';
      barEl.style.width = '0%';
      let pct = 0;
      percentTimer = setInterval(() => {
        pct += Math.random() * 3 + 0.8;
        if (pct >= 99) { pct = 99; clearInterval(percentTimer); }
        pctEl.textContent = String(Math.floor(pct));
        barEl.style.width = Math.floor(pct) + '%';
      }, 140);
      const fin = $('analyze-finalizing');
      fin.classList.add('hidden');
      fin.classList.remove('flex');
      steps.forEach((el) => {
        el.classList.add('opacity-40');
        el.querySelector('.check-dot').classList.remove('bg-pink', 'border-pink');
        el.querySelector('.check-spinner').classList.add('hidden');
        el.querySelector('.check-done').classList.add('hidden');
      });
      // 全ステップ完了後、結果がまだなら「まとめています…」を表示
      stepTimers.push(
        setTimeout(() => {
          fin.classList.remove('hidden');
          fin.classList.add('flex');
        }, steps.length * 720 + 850)
      );
      steps.forEach((el, i) => {
        // 点灯（スピナー表示）
        stepTimers.push(
          setTimeout(() => {
            el.classList.remove('opacity-40');
            el.querySelector('.check-dot').classList.add('border-pink');
            el.querySelector('.check-spinner').classList.remove('hidden');
          }, i * 720 + 200)
        );
        // 完了（チェック表示）
        stepTimers.push(
          setTimeout(() => {
            const dot = el.querySelector('.check-dot');
            dot.classList.add('bg-pink');
            el.querySelector('.check-spinner').classList.add('hidden');
            el.querySelector('.check-done').classList.remove('hidden');
          }, i * 720 + 720)
        );
      });
    }

    // ── 結果レンダリング ──
    function renderResult(data) {
      lastResult = data;
      if (percentTimer) clearInterval(percentTimer);
      // レポート申込フォームを初期状態に戻す（再診断時）
      $('report-form-body').classList.remove('hidden');
      $('mail-form').reset();
      $('mail-note').classList.remove('hidden');
      $('mail-done').classList.add('hidden');
      $('mail-error').classList.add('hidden');
      $('result-url').textContent = data.url;
      $('band-message').textContent = data.bandMessage;

      // ゲージ
      const circumference = 326.7;
      const arc = $('gauge-arc');
      arc.setAttribute('stroke', colorHex[data.total >= 75 ? 'green' : data.total >= 50 ? 'yellow' : 'red']);
      arc.style.strokeDashoffset = String(circumference);
      // 数字カウントアップ
      const numEl = $('gauge-number');
      let start = null;
      const duration = 1400;
      function tick(ts) {
        if (!start) start = ts;
        const p = Math.min((ts - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        numEl.textContent = String(Math.round(data.total * eased));
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(() => {
        arc.style.strokeDashoffset = String(circumference * (1 - data.total / 100));
        requestAnimationFrame(tick);
      });

      // 7軸カード
      const axesEl = $('axes');
      axesEl.innerHTML = '';
      const tint = { red: '#FCE9F0', yellow: '#F7F1DE', green: '#E4F3EC' };
      data.axes.forEach((ax, i) => {
        const row = document.createElement('div');
        row.className = 'rounded-xl border border-mist bg-paper p-4 md:p-5';
        // 根拠チップは全項目そのまま表示（ゲートは「どう直すか」＝詳細レポート側のみ）
        const evList = ax.evidence || [];
        const okCount = evList.filter(function (e) { return e.ok; }).length;
        const ngCount = evList.length - okCount;
        const evHtml = evList
          .map(function (e) {
            const mark =
              '<span style="color:' + (e.ok ? '#1F9D6B' : '#E43172') + ';font-weight:700">' +
              (e.ok ? '✓' : '✕') + '</span>';
            const val = e.value ? ' <span class="text-gray/60">' + esc(e.value) + '</span>' : '';
            return (
              '<span class="inline-flex items-center gap-1 text-xs ' +
              (e.ok ? 'text-ink' : 'text-gray') + '">' + mark + esc(e.label) + val + '</span>'
            );
          })
          .join('');
        const evSummary =
          '<span class="text-xs font-bold"><span style="color:#1F9D6B">✓' + okCount + '</span>' +
          '<span class="mx-1 text-gray/40">/</span><span class="text-pink">✕' + ngCount + '</span></span>';
        row.innerHTML =
          '<div class="flex items-center justify-between gap-3">' +
          '<span class="font-bold text-navy">' + ax.label + '</span>' +
          '<span class="inline-flex items-center gap-2">' + evSummary +
          '<span class="inline-flex min-w-[2.6rem] justify-center rounded-full px-2.5 py-0.5 font-display text-sm font-bold [font-variant-numeric:tabular-nums]" ' +
          'style="color:' + colorHex[ax.color] + ';background:' + tint[ax.color] + '">' + ax.score + '</span></span>' +
          '</div>' +
          '<div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-mist">' +
          '<div class="axis-bar h-full rounded-full" style="width:0%;background:' + colorHex[ax.color] + ';transition:width 1s cubic-bezier(0.22,1,0.36,1) ' + (0.3 + i * 0.1) + 's"></div>' +
          '</div>' +
          '<div class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 border-t border-mist pt-3">' + evHtml + '</div>';
        axesEl.appendChild(row);
        requestAnimationFrame(() => {
          row.querySelector('.axis-bar').style.width = ax.score + '%';
        });
      });

      // 指摘の中身は画面に出さず、件数だけカウントアップで見せる（中身はレポートでゲート）
      const issueTotal =
        (data.findings || []).length + Math.max(0, data.remainingCount || 0);
      const icEl = $('issue-count');
      let icStart = null;
      function icTick(ts) {
        if (!icStart) icStart = ts;
        const p = Math.min((ts - icStart) / 900, 1);
        icEl.textContent = String(Math.round(issueTotal * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(icTick);
      }
      icEl.textContent = '0';
      requestAnimationFrame(icTick);

      // ゲート出口：主CTAは詳細レポート（メール取得）。副は無料相談＋スコア別のサービス案内。
      const gh = $('gate-headline');
      const gd = $('gate-desc');
      const sub = $('cta-secondary');
      if (data.total < 65) {
        gh.textContent = 'この課題は、更新では直りません。';
        gd.textContent =
          '減点の多くはサイトの土台（構造・スマホ対応・速度）にあります。「どこから、どう直すか」をまとめた詳細レポートを無料でお送りします。';
        sub.textContent = 'リニューアル（¥198,000〜）の内容を見る';
        sub.href = '/renewal/';
      } else {
        gh.textContent = '土台は良好。運用で伸ばせます。';
        gd.textContent =
          '作り直しは不要です。「何から、どう伸ばすか」をまとめた詳細レポートを無料でお送りします。';
        sub.textContent = 'Web運用（月¥9,800〜）の内容を見る';
        sub.href = '/care/';
      }

      // 副CTA（今すぐ相談）：スコア・URLを相談フォームに引き継ぐ
      const params = new URLSearchParams({ url: data.url, score: String(data.total) });
      $('cta-consult').href = '/contact/?' + params.toString();

      // リビール（上から順に出す）
      document.querySelectorAll('.reveal').forEach((el) => {
        const delay = parseInt(el.dataset.reveal, 10) * 140;
        setTimeout(() => el.classList.add('is-in'), delay + 60);
      });
    }

    // ── 送信 ──
    const form = $('check-form');
    const errEl = $('input-error');
    let analyzeStart = 0;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.classList.add('hidden');
      const url = $('url-input').value.trim();
      if (!url) {
        errEl.textContent = 'URLを入力してください。';
        errEl.classList.remove('hidden');
        return;
      }

      $('loading-url').textContent = url;
      show('loading');
      runLoadingAnimation();
      analyzeStart = Date.now();

      try {
        const res = await fetch('/api/check', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ url }),
        });
        const data = await res.json();

        // 演出を最低限見せる（7ステップ完了まで＝約5.2秒）。
        const wait = Math.max(0, 5200 - (Date.now() - analyzeStart));
        setTimeout(() => {
          if (!res.ok) {
            errEl.textContent = data.error || '診断に失敗しました。時間をおいて再度お試しください。';
            errEl.classList.remove('hidden');
            show('input');
            return;
          }
          // JavaScriptで描画するサイトは採点せず、専用の説明画面を出す
          if (data.mode === 'spa') {
            renderSpa(data);
            show('spa');
            return;
          }
          renderResult(data);
          show('result');
        }, wait);
      } catch {
        const wait = Math.max(0, 1500 - (Date.now() - analyzeStart));
        setTimeout(() => {
          errEl.textContent = 'サイトを読み込めませんでした。URLをご確認ください。';
          errEl.classList.remove('hidden');
          show('input');
        }, wait);
      }
    });

    ['retry', 'spa-retry'].forEach((id) => {
      $(id).addEventListener('click', () => {
        $('url-input').value = '';
        show('input');
      });
    });

    // ── 主CTA：詳細レポートの申込（Formspreeでリード取得）──
    // レポートは担当者が手動で作成して返信するため、診断結果の全文を通知に含めておく
    // （担当者が診断をやり直さなくてもレポートを書ける状態にする）。
    const mailForm = $('mail-form');
    mailForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errP = $('mail-error');
      errP.classList.add('hidden');
      const email = $('mail-input').value.trim();
      if (!email) return;

      const btn = mailForm.querySelector('button[type="submit"]');
      const btnLabel = btn.textContent;
      btn.disabled = true;
      btn.textContent = '送信中…';

      const fd = new FormData(mailForm); // お名前・会社名・email・_gotcha を含む
      fd.append('種別', 'Web診断 詳細レポート希望');
      fd.append('_subject', '【plugdo】Web診断 詳細レポートのご依頼');
      if (lastResult) {
        fd.append('診断URL', lastResult.url);
        fd.append('総合スコア', String(lastResult.total) + '点');
        fd.append(
          '7軸スコア',
          (lastResult.axes || []).map((a) => a.label + ' ' + a.score).join(' / ')
        );
        fd.append(
          '指摘一覧',
          (lastResult.findings || [])
            .map((f, i) => String(i + 1) + '. ' + (typeof f === 'string' ? f : f.text))
            .join('\n')
        );
        if (lastResult.remainingCount) {
          fd.append('未表示の指摘数', String(lastResult.remainingCount) + '件');
        }
      }
      try {
        const res = await fetch(mailForm.action, {
          method: 'POST',
          body: fd,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          $('report-form-body').classList.add('hidden');
          $('mail-note').classList.add('hidden');
          const done = $('mail-done');
          done.textContent =
            'ありがとうございます。1営業日以内に、担当者より詳細レポートをメールでお送りします。';
          done.classList.remove('hidden');
        } else {
          errP.textContent = '送信に失敗しました。時間をおいて再度お試しください。';
          errP.classList.remove('hidden');
        }
      } catch {
        errP.textContent = '送信に失敗しました。時間をおいて再度お試しください。';
        errP.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = btnLabel;
      }
    });
  })();
</script>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.is-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* CV部分はホバーで動かさない。
     結果を読んでいる最中にボタンが浮き沈みすると視線がぶれ、押し損ねにもつながるため。
     色の変化だけ残して、押せることは伝わるようにしている。
     NOTE: .btn-pink / .btn-navy は @apply で展開されるため、要素に .btn は付かない。
           セレクタは実際のクラス名を指定すること。 */
  #screen-result :is(.btn-pink, .btn-navy):hover {
    transform: none;
  }
</style>
