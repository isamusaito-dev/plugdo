---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL, COMPANY } from '../lib/site';

// 診断レポートの申し込み完了ページ。
// Meta広告のコンバージョン計測はこのURL（/thanks/）を条件にする。
// noindex にしているのは、検索から直接来て偽のコンバージョンが立つのを避けるため。

const steps = [
  {
    n: '1',
    t: '担当者が実際のサイトを確認します',
    d: '自動診断の結果をそのまま送るのではなく、担当者が実際の画面を開いて、指摘が事実かどうかを1件ずつ確かめます。',
  },
  {
    n: '2',
    t: '詳細レポートをメールでお送りします',
    d: '1営業日以内に、ご入力のメールアドレス宛にPDFでお届けします。実際の画面のどこが問題かを、注釈つきでご覧いただけます。',
  },
  {
    n: '3',
    t: 'ご不明な点は無料相談で',
    d: 'レポートを読んだうえでのご質問だけでも構いません。売り込みはいたしません。',
  },
];
---

<BaseLayout
  title="お申し込みありがとうございます"
  description="Web診断の詳細レポートのお申し込みを受け付けました。1営業日以内にメールでお送りします。"
  noindex={true}
>
  <section class="hero-gradient">
    <div class="container-pd py-16 md:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <div
          class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-pink/10"
        >
          <svg
            class="h-7 w-7 text-pink"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>

        <h1 class="mt-6 text-2xl font-bold leading-snug text-navy md:text-3xl">
          お申し込みありがとうございます
        </h1>
        <p class="mt-4 text-sm leading-relaxed text-gray md:text-base">
          詳細レポートは、<strong class="font-bold text-navy">1営業日以内</strong>に
          ご入力のメールアドレス宛にお送りします。
        </p>
      </div>

      <!-- このあとの流れ -->
      <ol class="mx-auto mt-12 max-w-2xl space-y-3">
        {
          steps.map((s) => (
            <li class="flex gap-4 rounded-xl border border-navy/10 bg-white p-5">
              <span
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-navy text-xs font-bold text-white"
              >
                {s.n}
              </span>
              <div>
                <p class="text-sm font-bold text-navy">{s.t}</p>
                <p class="mt-1.5 text-[13px] leading-relaxed text-gray">{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- 先に相談したい方向け -->
      <div class="mx-auto mt-10 max-w-2xl rounded-xl bg-navy p-7 text-center md:p-9">
        <p class="text-base font-bold leading-snug text-white md:text-lg">
          レポートを待たずに、先に相談することもできます
        </p>
        <p class="mx-auto mt-3 max-w-lg text-[13px] leading-relaxed text-white/70">
          「どこから手をつけるか」の順番、費用と期間の目安、ご自身で直せる分の手順を、
          30分でお持ち帰りいただけます。
        </p>
        <a
          href={BOOKING_URL}
          target="_blank"
          rel="noopener"
          id="thanks-booking"
          class="btn-pink mt-6 !px-8 !py-3.5"
        >
          無料相談を予約する
        </a>
        <p class="mt-3 text-[11px] text-white/50">
          オンライン30分／カメラなしでも構いません
        </p>
      </div>

      <!-- メールが届かないとき -->
      <div class="mx-auto mt-8 max-w-2xl text-center">
        <p class="text-[13px] leading-relaxed text-gray">
          メールが届かない場合は、迷惑メールフォルダをご確認ください。
          それでも見当たらないときは
          <a href={`mailto:${COMPANY.email}`} class="font-bold text-navy underline">
            {COMPANY.email}
          </a>
          までご連絡ください。
        </p>
        <a href="/" class="mt-7 inline-block text-sm font-bold text-navy underline">
          トップページへ戻る
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Meta広告のコンバージョン。URL条件（/thanks/）でも拾えるが、
  // 標準イベントで送っておくと広告側の最適化に使える。
  if (typeof window.fbq === 'function') {
    window.fbq('track', 'Lead', { content_name: 'diagnosis_report' });
  }

  // GA4。本命の generate_lead は /check/ 側で送っているので、
  // ここでは「サンクスページから予約に進んだか」だけを見る。
  document.getElementById('thanks-booking')?.addEventListener('click', function () {
    if (typeof window.gtag !== 'function') return;
    try {
      window.gtag('event', 'booking_click', { location: 'thanks' });
    } catch (_) {}
  });
</script>
