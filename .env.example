# microCMS
MICROCMS_SERVICE_DOMAIN=xxxxx
MICROCMS_API_KEY=xxxxx

# Formspree（PUBLIC_ プレフィックスでクライアントに公開される）
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxx

# Google Analytics 4
PUBLIC_GA_ID=G-XXXXXXX

# サイトURL（canonical / OGP / sitemap で使用）
PUBLIC_SITE_URL=https://plugdo.jp

# Meta（Facebook）ピクセル ID。広告を出すときだけ設定する。
# 未設定ならピクセルのコードは一切出力されない。
PUBLIC_META_PIXEL_ID=
